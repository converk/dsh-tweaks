{
  "name": "dsh-tweaks-model-capabilities",
  "description": "在 DSH 设置→模型的官方模型行补上 llm-pi-ai 的思考强度（OpenAI / Anthropic 预置）与 1M/128K 容量快捷",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/converk/dsh-tweaks.git",
    "directory": "plugins/model-capabilities"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "selftest": "node scripts/selftest.mjs"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
