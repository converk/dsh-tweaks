{
  "name": "dsh-tweaks-prompt-history",
  "description": "在会话输入框中用 ↑/↓ 方向键召回本会话已发送的历史提示词",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/converk/dsh-tweaks.git",
    "directory": "plugins/prompt-history"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
